{
  "name": "huroof-wa-oloof",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "import:categories": "tsx scripts/import-tahadani-categories.ts",
    "build:category-assets": "tsx scripts/build-category-assets.ts",
    "generate:pilot": "tsx scripts/generate-pilot-drafts.ts",
    "import:questions:v3": "tsx scripts/import-question-candidates-v3.ts",
    "review:questions:v3": "tsx scripts/review-questions-v3.ts",
    "validate:pilots:v3": "tsx scripts/validate-question-pilots-v3.1.ts",
    "test:pilots:v3": "tsx --test tests/authoring-v3-pilots.test.ts",
    "migrate:pilots:v3.2": "tsx scripts/migrate-question-pilots-v3.2.ts",
    "validate:pilots:v3.2": "tsx scripts/validate-question-pilots-v3.2.ts",
    "report:alias-remediation:v3.2": "tsx scripts/report-v32-alias-remediation.ts",
    "test:pilots:v3.2": "tsx --test tests/question-bank-v3.2.test.ts",
    "validate:questions": "tsx scripts/validate-question-bank.ts",
    "simulate:boards": "tsx scripts/simulate-boards.ts",
    "simulate:authoring": "tsx scripts/simulate-authoring-v2.ts && tsx scripts/authoring-v2.1.ts validate --as-of 2026-09-03 --check",
    "plan:authoring": "tsx scripts/authoring-v2.1.ts plan",
    "validate:authoring": "tsx scripts/authoring-v2.1.ts validate --as-of 2026-09-03",
    "promote:authoring": "tsx scripts/authoring-v2.1.ts promote",
    "build:firestore-release": "tsx scripts/build-firestore-release.ts",
    "build:firestore-release:dry-run": "npm run build:firestore-release -- --dry-run",
    "firestore:production:plan": "tsx scripts/firestore-release-publisher.ts plan",
    "firestore:production:prepare": "tsx scripts/firestore-release-publisher.ts prepare",
    "firestore:production:verify": "tsx scripts/firestore-release-publisher.ts verify",
    "firestore:production:activate": "tsx scripts/firestore-release-publisher.ts activate",
    "seed:firestore": "tsx scripts/seed-firestore.ts",
    "seed:firestore:dry-run": "npm run seed:firestore -- --dry-run",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions test",
    "test:firestore-rules:running": "tsx tests/firestore-rules.test.ts",
    "test:firestore-rules": "firebase emulators:exec --only firestore \"npm run test:firestore-rules:running\" --project demo-huroof-wa-oloof",
    "dev": "concurrently -k -n server,vite \"npm run dev:server\" \"vite\"",
    "dev:server": "tsx server/index.ts",
    "dev:full": "npm run dev",
    "start:local": "tsx server/index.ts",
    "start": "npm run start:local",
    "build": "tsc -p tsconfig.app.json && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:game": "tsc -p tsconfig.game.json --noEmit",
    "lint": "eslint src scripts tests --ext .ts,.tsx",
    "lint:game": "eslint src/features/game src/routes/GameRoutes.tsx server tests/game --ext .ts,.tsx",
    "scan:visual": "tsx scripts/scan-visual-contract.ts",
    "test:content": "tsx --test tests/question-bank.test.ts tests/authoring-v2.test.ts tests/authoring-v2.1.test.ts tests/authoring-v3.test.ts tests/firestore-release.test.ts tests/firestore-release-publisher.test.ts tests/runtime-selector.test.ts",
    "test:ui": "vitest run",
    "test:game": "tsx --test tests/game/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:firebase": "tsx scripts/test-firebase-e2e.ts",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "verify": "npm run typecheck && npm run lint && npm run scan:visual && npm run test:content && npm run test:ui && npm run test:game && npm run build",
    "test": "npm run test:content && npm run test:ui",
    "check": "npm run validate:questions -- --as-of 2026-09-04 && npm run validate:authoring && npm run simulate:authoring && npm run typecheck && npm run lint && npm run test",
    "test:storage-rules:running": "tsx tests/storage-rules.test.ts",
    "test:storage-rules": "firebase emulators:exec --only storage \"npm run test:storage-rules:running\" --project demo-huroof-wa-oloof",
    "test:firebase-rules": "firebase emulators:exec --only firestore,storage \"npm run test:firestore-rules:running && npm run test:storage-rules:running\" --project demo-huroof-wa-oloof"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.29.0",
    "google-auth-library": "^10.9.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "ws": "^8.21.3"
  }
}
