{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question-bank-v3/pilot-evidence.v3.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["packetId", "schemaVersion", "categoryId", "claimId", "sourcePolicyId", "sourceIdentityId", "sourceIdentitySha256", "canonicalUrl", "publisher", "title", "locator", "retrievedAt", "httpStatus", "responseContentType", "responseBody", "responseBodySha256", "excerptBase64", "excerptSha256", "claimSupportTokens", "sourceTier", "freshness"],
  "properties": {
    "packetId": {"type": "string", "pattern": "^pilot-packet-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "schemaVersion": {"const": "3.1.0"},
    "categoryId": {"type": "string", "pattern": "^(?:tahadani-[0-9]{3}|huroof-00[1-4])$"},
    "claimId": {"type": "string", "pattern": "^pilot-claim-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "sourcePolicyId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100},
    "sourceIdentityId": {"type": "string", "pattern": "^pilot-source-[a-f0-9]{64}$"},
    "sourceIdentitySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "canonicalUrl": {"type": "string", "format": "uri", "maxLength": 1024},
    "publisher": {"type": "string", "minLength": 1, "maxLength": 180},
    "title": {"type": "string", "minLength": 1, "maxLength": 280},
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "startByte", "endByte"],
      "properties": {
        "kind": {"const": "response_body_byte_range"},
        "startByte": {"type": "integer", "minimum": 0},
        "endByte": {"type": "integer", "minimum": 1}
      }
    },
    "retrievedAt": {"type": "string", "format": "date"},
    "httpStatus": {"type": "integer", "minimum": 200, "maximum": 299},
    "responseContentType": {"type": "string", "minLength": 3, "maxLength": 160},
    "responseBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storeVersion", "sha256", "byteLength"],
      "properties": {
        "storeVersion": {"const": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byteLength": {"type": "integer", "minimum": 1, "maximum": 1310720}
      }
    },
    "responseBodySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "excerptBase64": {"type": "string", "minLength": 4},
    "excerptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "claimSupportTokens": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 80}},
    "sourceTier": {"enum": ["official", "authoritative", "primary"]},
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "validUntil"],
      "properties": {
        "class": {"enum": ["stable", "dated"]},
        "validUntil": {"type": ["string", "null"], "format": "date"}
      }
    }
  }
}
