{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question-bank-v3/pilot-question.v3.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schemaVersion", "categoryId", "modality", "state", "headerAr", "promptAr", "canonicalAnswer", "acceptedAnswers", "difficulty", "difficultyRationale", "explanationAr", "temporal", "evidencePolicy", "claimIds", "evidencePacketIds", "media", "provenance", "charadesReview"],
  "properties": {
    "id": {"type": "string", "pattern": "^pilot-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "schemaVersion": {"const": "3.1.0"},
    "categoryId": {"type": "string", "pattern": "^(?:tahadani-[0-9]{3}|huroof-00[1-4])$"},
    "modality": {"enum": ["classic", "image", "charades"]},
    "state": {"enum": ["draft", "evidence_ready", "ready_for_human"]},
    "headerAr": {"type": "string", "minLength": 1, "maxLength": 120},
    "promptAr": {"type": "string", "minLength": 20, "maxLength": 220},
    "canonicalAnswer": {"type": "string", "minLength": 1, "maxLength": 60},
    "acceptedAnswers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 60}},
    "targetLetter": {"enum": ["ا", "ب", "ت", "ث", "ج", "ح", "خ", "د", "ذ", "ر", "ز", "س", "ش", "ص", "ض", "ط", "ظ", "ع", "غ", "ف", "ق", "ك", "ل", "م", "ن", "ه", "و", "ي"]},
    "acceptDefiniteArticle": {"type": "boolean"},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "difficultyRationale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["difficulty", "rationale", "familiarity", "clueDirectness", "domainSpecificity", "retrievalBurden", "score"],
      "properties": {
        "difficulty": {"enum": ["easy", "medium", "hard"]},
        "rationale": {"type": "string", "minLength": 12, "maxLength": 360},
        "familiarity": {"type": "integer", "minimum": 1, "maximum": 5},
        "clueDirectness": {"type": "integer", "minimum": 1, "maximum": 5},
        "domainSpecificity": {"type": "integer", "minimum": 1, "maximum": 5},
        "retrievalBurden": {"type": "integer", "minimum": 1, "maximum": 5},
        "score": {"type": "integer", "minimum": 4, "maximum": 20}
      }
    },
    "explanationAr": {"type": ["string", "null"], "maxLength": 280},
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "checkedAt", "validUntil"],
      "properties": {
        "kind": {"enum": ["stable", "dated"]},
        "checkedAt": {"type": "string", "format": "date"},
        "validUntil": {"type": ["string", "null"], "format": "date"}
      }
    },
    "evidencePolicy": {"enum": ["factual_sources_required", "not_applicable_charades"]},
    "claimIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^pilot-claim-[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "evidencePacketIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^pilot-packet-[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "media": {"type": ["object", "null"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoringMethod", "createdAt"],
      "properties": {
        "authoringMethod": {"enum": ["human", "model_assisted"]},
        "createdAt": {"type": "string", "format": "date"}
      }
    },
    "charadesReview": {
      "type": ["object", "null"],
      "properties": {
        "originality": {"const": "pending_human_review"},
        "suitability": {"const": "pending_human_review"}
      },
      "required": ["originality", "suitability"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"required": ["modality"], "properties": {"modality": {"const": "charades"}}},
      "then": {
        "properties": {
          "evidencePolicy": {"const": "not_applicable_charades"},
          "claimIds": {"maxItems": 0},
          "evidencePacketIds": {"maxItems": 0},
          "charadesReview": {"type": "object"}
        },
        "not": {"anyOf": [{"required": ["targetLetter"]}, {"required": ["acceptDefiniteArticle"]}]}
      }
    },
    {
      "if": {"required": ["modality"], "properties": {"modality": {"enum": ["classic", "image"]}}},
      "then": {
        "required": ["targetLetter", "acceptDefiniteArticle"],
        "properties": {
          "evidencePolicy": {"const": "factual_sources_required"},
          "claimIds": {"minItems": 1},
          "evidencePacketIds": {"minItems": 1},
          "charadesReview": {"type": "null"}
        }
      }
    }
  ]
}
