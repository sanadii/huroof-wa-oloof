{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"question-bank-v3/slot-ledger.v3.3.schema.json","type":"object","additionalProperties":false,"required":["slotId","categoryId","modality","ordinal","difficulty","state"],"properties":{"slotId":{"type":"string","minLength":1},"categoryId":{"pattern":"^tahadani-(0[0-5][0-9]|06[0-2])$"},"modality":{"enum":["classic","image","charades"]},"ordinal":{"type":"integer","minimum":1,"maximum":336},"difficulty":{"enum":["easy","medium","hard"]},"state":{"enum":["unfilled","blocked"]},"targetLetter":{"pattern":"^[ء-ي]$"},"facetId":{"type":"string","minLength":1},"performanceFacetId":{"type":"string","minLength":1}},"allOf":[{"if":{"properties":{"modality":{"const":"charades"}},"required":["modality"]},"then":{"required":["performanceFacetId"],"not":{"anyOf":[{"required":["targetLetter"]},{"required":["facetId"]}]}},"else":{"required":["targetLetter","facetId"],"not":{"required":["performanceFacetId"]}}}]}
