{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Classic Question V2 Draft",
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "categoryId",
    "targetLetter",
    "headerAr",
    "promptAr",
    "canonicalAnswer",
    "acceptedAnswers",
    "difficulty",
    "status",
    "sourcePacketIds",
    "temporal",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "status": {
      "const": "draft"
    },
    "headerAr": {
      "type": "string"
    },
    "promptAr": {
      "type": "string"
    },
    "canonicalAnswer": {
      "type": "string"
    },
    "explanationAr": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourcePacketIds": {
      "type": "array",
      "minItems": 1
    },
    "temporal": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  }
}
