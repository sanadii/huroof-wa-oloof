{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "asOf",
    "categoryIds",
    "approvedCount",
    "approvedContentHash",
    "roots",
    "immutable"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.1.0"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "asOf": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "categoryIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "approvedCount": {
      "type": "integer",
      "minimum": 1
    },
    "approvedContentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogHash",
        "policyHash",
        "receiptHash",
        "sourceHash",
        "mediaHash"
      ],
      "properties": {
        "catalogHash": {
          "type": "string",
          "minLength": 1
        },
        "policyHash": {
          "type": "string",
          "minLength": 1
        },
        "receiptHash": {
          "type": "string",
          "minLength": 1
        },
        "sourceHash": {
          "type": "string",
          "minLength": 1
        },
        "mediaHash": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "immutable": {
      "const": true
    }
  }
}
