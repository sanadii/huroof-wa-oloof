{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draftId",
    "asOf",
    "sourcePacketIds",
    "reviewReceiptIds"
  ],
  "properties": {
    "draftId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "asOf": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sourcePacketIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "reviewReceiptIds": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    }
  }
}
