{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "categoryId",
    "slotId",
    "targetLetter",
    "modality",
    "status",
    "approvedAt",
    "validUntil",
    "policyVersion",
    "schemaValid",
    "policyValid",
    "contentHash",
    "sourcePacketIds",
    "reviewReceiptIds"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "categoryId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "slotId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "targetLetter": {
      "type": "string",
      "minLength": 1
    },
    "modality": {
      "const": "classic"
    },
    "status": {
      "const": "approved"
    },
    "approvedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "validUntil": {
      "type": [
        "string",
        "null"
      ]
    },
    "policyVersion": {
      "const": "2.1.0"
    },
    "schemaValid": {
      "const": true
    },
    "policyValid": {
      "const": true
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourcePacketIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "reviewReceiptIds": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    }
  }
}
