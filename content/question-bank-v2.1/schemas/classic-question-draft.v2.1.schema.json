{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schemaVersion",
    "locale",
    "categoryId",
    "slotId",
    "targetLetter",
    "headerAr",
    "promptAr",
    "canonicalAnswer",
    "acceptedAnswers",
    "acceptDefiniteArticle",
    "difficulty",
    "questionType",
    "explanationAr",
    "status",
    "sourcePacketIds",
    "sourceLocator",
    "temporal",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "schemaVersion": {
      "const": "2.1.0"
    },
    "locale": {
      "const": "ar-KW"
    },
    "categoryId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "slotId": {
      "type": "string",
      "minLength": 1
    },
    "targetLetter": {
      "enum": [
        "ا",
        "ب",
        "ت",
        "ث",
        "ج",
        "ح",
        "خ",
        "د",
        "ذ",
        "ر",
        "ز",
        "س",
        "ش",
        "ص",
        "ض",
        "ط",
        "ظ",
        "ع",
        "غ",
        "ف",
        "ق",
        "ك",
        "ل",
        "م",
        "ن",
        "ه",
        "و",
        "ي"
      ]
    },
    "headerAr": {
      "type": "string",
      "minLength": 1
    },
    "promptAr": {
      "type": "string",
      "minLength": 1
    },
    "canonicalAnswer": {
      "type": "string",
      "minLength": 1
    },
    "acceptedAnswers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptDefiniteArticle": {
      "type": "boolean"
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "questionType": {
      "const": "text"
    },
    "explanationAr": {
      "type": "null"
    },
    "status": {
      "const": "draft"
    },
    "sourcePacketIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "sourceLocator": {
      "type": "string",
      "minLength": 1
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "checkedAt",
        "validUntil"
      ],
      "properties": {
        "kind": {
          "const": "stable"
        },
        "checkedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "validUntil": {
          "type": "null"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "model",
        "createdAt"
      ],
      "properties": {
        "method": {
          "enum": [
            "human",
            "model_assisted"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  }
}
