# Production builds remain in fixture mode until backend deployment and runtime
# protocol work are separately approved. An explicit value below is honored by
# development as well; without one, Vite serves through the local authority. The Firebase CLI default remains the
# isolated demo project; the explicit production alias is huroof-a3ee7. Neither
# alias configures this browser client.
VITE_GAME_RUNTIME=fixture
# Explicitly mark a static-hosting UI-only preview. Keep unset for local fixture
# and Firebase runtimes; this disables room/API/admin actions before transport.
VITE_STATIC_PREVIEW=false
# Optional public or LAN origin used as the initial host QR join address. It must
# be an http(s) origin without a path; leave blank for the current browser origin.
VITE_PUBLIC_JOIN_ORIGIN=
# Keep LAN listening opt-in. The dev proxy blocks every /api/admin request whose
# direct socket peer is not loopback before it reaches the local authority.
VITE_ALLOW_LAN=false

# Firebase Authentication needs all four public Firebase Web config values below,
# even when VITE_GAME_RUNTIME remains fixture. These VITE_* values identify the
# web app and are public client configuration, not secrets; never commit real values.
# Game Firestore/Functions still require VITE_GAME_RUNTIME=firebase and App Check.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=me-central2
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# Production build preflight requires the immutable release identity pinned by a
# prior verified release operation. This is build metadata, not browser config.
FIREBASE_ACTIVE_RELEASE_ID=
FIREBASE_ACTIVE_RELEASE_ROOT_SHA256=
# Emulator attachment is opt-in. Use the explicit `demo` Firebase CLI alias
# (demo-huroof-wa-oloof) for emulator commands; never rely on the default alias.
VITE_USE_FIREBASE_EMULATORS=false
# Optional test-only overrides. They are read only when emulator attachment is enabled;
# omitted values preserve the standard 9099/8080/5001/9199 defaults.
VITE_FIREBASE_AUTH_EMULATOR_PORT=
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=
VITE_FIREBASE_FUNCTIONS_EMULATOR_PORT=
VITE_FIREBASE_STORAGE_EMULATOR_PORT=

# Explicit local-only test source for the already imported SQLite intake. It reads
# the local database only; it does not enable Firestore, approval, or publication.
# LOCAL_DB_QUESTION_SOURCE=sqlite-import
# LOCAL_DB_TRUSTED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
